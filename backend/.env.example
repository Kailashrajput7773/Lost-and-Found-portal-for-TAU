# Server Port
PORT=5000

# MongoDB URI (MongoDB Atlas in Production or mongodb://localhost:27017/lostandfound locally)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lostandfound?retryWrites=true&w=majority

# Secret Administrative Passphrase
ADMIN_KEY=your-secure-admin-key-2026

# Allowed Frontend URL for CORS in production (e.g. Vercel deployment)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Email Dispatch Configuration (for sending real OTPs and notifications)
EMAIL_USER=lostportalhub@gmail.com
EMAIL_PASS=your-gmail-app-password

# Optional: Cloudinary Cloud Storage for production image persistence (Free tier)
# If left empty, uploads are stored locally in backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
